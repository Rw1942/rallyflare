{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rally-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",

  // rallyflare calls this Worker over RPC; workers.dev only serves a health check.
  "workers_dev": true,
  "preview_urls": true,

  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true }
  },

  "vars": {
    "POSTMARK_URL": "https://api.postmarkapp.com/email"
  },

  "secrets": { "required": ["POSTMARK_TOKEN"] }
}
