{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rallyflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",

  // The dashboard and webhook are served on workers.dev behind Cloudflare Access.
  "workers_dev": true,
  "preview_urls": true,

  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rally-database",
      "database_id": "d80adc3d-40bf-4371-954b-884527f2a2c9",
      "migrations_dir": "../../migrations"
    }
  ],

  "services": [
    { "binding": "MAILER", "service": "rally-mailer" },
    { "binding": "AI", "service": "rally-ai" },
    { "binding": "ATTACHMENTS", "service": "rally-attachments" }
  ],

  // HTTP Basic Auth credentials that Postmark sends with each inbound webhook.
  "secrets": { "required": ["WEBHOOK_USERNAME", "WEBHOOK_PASSWORD"] }
}
